# Copy this file to .env and fill in real values for local development.
# Never commit the real .env -- see .gitignore.

# Django secret key. Generate a fresh one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Gmail SMTP credentials (app password, not your real Gmail password --
# generate one at https://myaccount.google.com/apppasswords).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
